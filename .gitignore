build/
.cache/
__pycache__/

# Poptropica's files aren't distributed: rebuild them with python external/maf-extract/extract.py pnp (see README.md).
# Measurements (frames.json, badges.json) and the pieces in svg/added/ are this project's own and stay.
/external/*
!/external/maf-extract
/assets/fonts/
/assets/img/
/assets/svg/art/
/assets/svg/backs/
/assets/svg/badges/*.svg
/assets/svg/frames/*.svg
/assets/svg/pieces/
/data/original_cards.json
